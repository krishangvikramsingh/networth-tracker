{
	"$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
	"files": {
		"includes": ["src/**", "!src/web/public", "tests/**", "scripts/**"]
	},
	"formatter": {
		"enabled": false
	},
	"assist": {
		"enabled": false
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": "off",
			"suspicious": {
				"noExplicitAny": "off",
				"noArrayIndexKey": "off",
				"noDuplicateProperties": "off"
			},
			"performance": {
				"useDomNodeTextContent": "off"
			},
			"complexity": {
				"noImportantStyles": "off"
			},
			"correctness": {
				"useExhaustiveDependencies": "off"
			},
			"a11y": {
				"noAutofocus": "off"
			}
		}
	}
}
