# Copy to .env (or export) before running. Nothing here is required for the local demo.
PORT=8787
HOST=127.0.0.1
NODE_ENV=development
# DATABASE_PATH=./data/networth.db
# Fix "today" for a reproducible demo (yyyy-mm-dd); default is the real date
# APP_AS_OF=2026-10-20
# Synthetic demo accounts (created on first run). In production random passwords are printed once if these are unset.
# DEMO_ADMIN_EMAIL=advisor@demo.local
# DEMO_ADMIN_PASSWORD=
# DEMO_VIEWER_EMAIL=viewer@demo.local
# DEMO_VIEWER_PASSWORD=
# Market-data adapters (see docs/MARKET_DATA.md)
# AMFI_NAV_URL=https://www.amfiindia.com/spages/NAVAll.txt
# NSE_DATA_API_KEY=
# SP500_DATA_API_KEY=
# MARKET_MIN_INTERVAL_SECONDS=30
LOG_LEVEL=info
# Behind a reverse proxy: number of proxy hops (e.g. 1) so the login throttle sees real client addresses.
# TRUST_PROXY=1
# How often alerts are reconciled in the background (seconds; 0 = off). Reads never reconcile.
# RECONCILE_INTERVAL_SECONDS=300
# Email alerts (see /notifications). Without SMTP_HOST, messages are saved to a local outbox instead of being sent.
# APP_BASE_URL=http://127.0.0.1:8787
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Wealth Intelligence <alerts@example.com>"
# NOTIFY_INTERVAL_SECONDS=60       # 0 turns the background sender off
# NOTIFY_INCLUDE_DETAILS=1         # add figures and advice text to emails (email is not a private channel)
# PUBLIC_URL=https://wealth.example.com  # required in production: the host used in password-reset links (never taken from the request)
