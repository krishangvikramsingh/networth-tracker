# Copy to .env (or export) before running. Nothing here is required for the local demo.
PORT=8787
HOST=127.0.0.1
NODE_ENV=development
# DATABASE_PATH=./data/networth.db
# Fix "today" for a reproducible demo (yyyy-mm-dd); default is the real date
# APP_AS_OF=2026-10-20
# Synthetic demo accounts (created on first run). In production random passwords are printed once if these are unset.
# DEMO_ADMIN_EMAIL=advisor@demo.local
# DEMO_ADMIN_PASSWORD=
# DEMO_VIEWER_EMAIL=viewer@demo.local
# DEMO_VIEWER_PASSWORD=
# Market-data adapters (see docs/MARKET_DATA.md)
# AMFI_NAV_URL=https://www.amfiindia.com/spages/NAVAll.txt
# NSE_DATA_API_KEY=
# SP500_DATA_API_KEY=
# MARKET_CACHE_SECONDS=900
# MARKET_MIN_INTERVAL_SECONDS=30
LOG_LEVEL=info
