{
  "name": "networth-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Personal wealth intelligence platform - NMIMS MPSTME Design Experience project",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "npm run build && node --import tsx src/server/index.ts",
    "serve": "node --import tsx src/server/index.ts",
    "seed": "node --import tsx src/server/seed-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.mjs",
    "test:a11y": "node scripts/a11y.mjs",
    "test:visual": "node scripts/visual.mjs",
    "test:e2e:auth": "node scripts/e2e-auth.mjs",
    "user:create": "node --import tsx src/server/user-cli.ts",
    "lint": "biome lint"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "compression": "^1.8.2",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "nodemailer": "^10.2.1",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.3",
    "pixelmatch": "^8.0.0",
    "playwright-core": "^1.64.1",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
